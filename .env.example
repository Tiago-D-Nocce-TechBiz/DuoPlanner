# Copie para .env.local e preencha. Nunca commite chaves reais.

# Supabase (persistência de buscas, despesas e memória da IA)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site — usada para montar o link de convite do parceiro(a).
# Opcional: o padrão é https://duoplanner-vert.vercel.app
# NEXT_PUBLIC_SITE_URL=https://duoplanner-vert.vercel.app

# Google Gemini (Google AI Studio) — OCR de recibos, memória e experiências
GEMINI_API_KEY=
# Opcional: troca o modelo sem mudar código (padrão: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Opcional: proxy/gateway compatível com a API do Gemini
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Kiwi.com Tequila — motor de voos (chave de parceiro; novas contas só por convite)
KIWI_API_KEY=
# Opcional (padrão: https://api.tequila.kiwi.com)
# KIWI_API_BASE_URL=https://api.tequila.kiwi.com

# RapidAPI — motor de hospedagem (assinatura da API "Booking.com15")
RAPIDAPI_KEY=
# Opcional (padrão: booking-com15.p.rapidapi.com)
# RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com
