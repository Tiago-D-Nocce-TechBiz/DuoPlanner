# Copie para .env.local e preencha. Nunca commite chaves reais.
#
# Validação (src/lib/env/): valor MALFORMADO interrompe o build e o boot do
# servidor (ex.: chave secreta numa variável NEXT_PUBLIC_, URL inválida,
# CRON_SECRET curto). Variável AUSENTE só desliga aquela integração (modo
# degradado); o log do build lista o que está ativo e o que está degradado.

# Supabase (contas, banco e sincronização do casal)
# Região: o vercel.json fixa as funções em gru1 (São Paulo). Precisa ser a
# mesma do projeto Supabase (Project Settings → General → Region = sa-east-1);
# se o banco estiver em outra, troque gru1 pela região Vercel mais próxima
# dele, ou cada consulta atravessa o continente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexão Postgres direta: OPCIONAL e NÃO usada pelo app hoje. O app fala com
# o banco só pela API HTTP do Supabase (PostgREST, via supabase-js), sem
# conexão TCP por função e sem pool para gerenciar. Se um cliente Postgres
# direto entrar (script, ORM, CLI de migrations) rodando em função serverless,
# use o Supavisor em modo TRANSAÇÃO (porta 6543), não a conexão direta (5432):
# cada invocação abriria uma conexão nova até esgotar o limite do banco.
# Nesse modo não há prepared statements (Prisma: ?pgbouncer=true;
# postgres.js: prepare: false). Supabase → Connect → Transaction pooler:
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave SECRETA do Supabase (sb_secret_... ou a antiga service_role).
# Só as tarefas agendadas (/api/cron/*) usam: ignora a RLS. Nunca use em
# variáveis NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública do site — links de convite e dos e-mails.
# Opcional: o padrão é https://duoplanner-vert.vercel.app
# NEXT_PUBLIC_SITE_URL=https://duoplanner-vert.vercel.app

# Tarefas agendadas (Vercel Cron): segredo com 16+ caracteres.
# A Vercel envia como "Authorization: Bearer <CRON_SECRET>".
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# E-mails (Resend). Sem a chave, nada é enviado (só registro no log).
RESEND_API_KEY=
# Remetente de um domínio verificado na Resend. O padrão abaixo só entrega
# para o e-mail da própria conta da Resend (serve para testar).
# EMAIL_REMETENTE=DuoPlanner <onboarding@resend.dev>

# Cifra dos números de documentos (AES-256-GCM): 32 bytes em base64.
# Sem ela, só os 4 últimos dígitos são guardados.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENTOS_CHAVE_CRIPTO=

# Google Gemini (Google AI Studio) — recibos, categorização da fatura e memória
GEMINI_API_KEY=
# Opcional: troca o modelo sem mudar código (padrão: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Opcional: proxy/gateway compatível com a API do Gemini
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Kiwi.com Tequila — motor de voos (chave de parceiro; novas contas só por convite)
KIWI_API_KEY=
# Opcional (padrão: https://api.tequila.kiwi.com)
# KIWI_API_BASE_URL=https://api.tequila.kiwi.com

# RapidAPI — motor de hospedagem (assinatura da API "Booking.com15")
RAPIDAPI_KEY=
# Opcional (padrão: booking-com15.p.rapidapi.com)
# RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com
