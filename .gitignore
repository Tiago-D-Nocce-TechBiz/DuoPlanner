# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (em qualquer nível: inclui node_modules de ferramentas locais)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# ambientes temporários de testes (e2e, validação de SQL): nunca versionar.
# `.tmp-e2e/` já entrou por engano no commit 37ddd07 (com node_modules).
.tmp-e2e/
.tmp-*/
# relatórios e caches do Playwright (tests/e2e)
/playwright-report/
/blob-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
